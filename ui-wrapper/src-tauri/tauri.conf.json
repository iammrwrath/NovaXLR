{
  "productName": "NovaXLR",
  "version": "1.2.6",
  "identifier": "com.iammrwrath.novaxlr",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "$schema": "../gen/schemas/desktop-schema.json",
          "identifier": "browser-open",
          "description": "Permit the WebUI to Open Links in the systems default browser",
          "windows": [
            "main"
          ],
          "local": true,
          "remote": {
            "urls": [
              "http://localhost:*/*",
              "http://127.0.0.1:*/*"
            ]
          },
          "permissions": [
            "opener:default",
            "opener:allow-open-url"
          ],
          "capabilities": [
          ]
        }
      ]
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "title": "NovaXLR",
        "width": 1300,
        "height": 910,
        "minWidth": 800,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "appimage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}